# Copiar a .env y cambiar los valores. El archivo .env NO se sube al repositorio.
POSTGRES_USER=citas_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=citas

# Fase 3 (API fuera de Docker): se usa localhost.
# Fases 5 y 6 (API en contenedor): reemplazar localhost por citas-db.
DATABASE_URL=postgresql://citas_user:cambiar_esta_clave@localhost:5432/citas
